# Aegis Backend Environment Variables
# Copy this to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM Models (defaults are fine for most cases)
PRIMARY_MODEL=claude-sonnet-4-5-20250514
SECONDARY_MODEL=claude-haiku-4-5-20251001

# API Security - shared secret between frontend and backend
API_KEY=change-this-to-a-random-string

# Pipeline Settings
MAX_CODE_REVISION_CYCLES=2
MAX_DESIGN_REVISION_CYCLES=1
MAX_CLARIFICATION_ROUNDS=3

# Database
DATABASE_PATH=aegis.db

# Output directory for generated projects
OUTPUT_DIR=outputs
