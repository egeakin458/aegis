rectangle "**Aegis**\n«Virtual Software Company»" as Aegis #EAF1FF;line:1F6FEB;line.bold {
}

cloud "Anthropic\nClaude API\n<size:10><color:#666666>claude-sonnet-4-6</color></size>" as LLM
