@startuml ActivityDiagram
!include _theme.iuml
title **Aegis — Agent Execution Activity Diagram**\n<size:11><color:#666666>Pipeline state transitions with revision loops</color></size>

start
:Receive CustomerConfigV2\nfrom intake form;
:**Requirements Analyst**\nproduce RAOutputDDC;

if (needs_clarification?) then (yes)
  :Pause pipeline\n(CLARIFICATION);
  :Wait for user answers;
  :Resume — re-run RA;
  detach
else (no)
endif

:Finalize CustomerConfigV2;
:**Solution Architect**\nproduce TechnicalDesign;

repeat
  :**Developer**\nproduce CodeOutput\n(or CodePatch on revision);
  :**Build Check**\n(sandboxed `next build`);
  if (build passed?) then (yes)
    :**QA Reviewer**\nproduce QAReview;
    switch (verdict?)
    case ( approve )
      :Approved\n(exit revision loop);
      :save_output()\nwrite files + manifest.json;
      :Emit PIPELINE_COMPLETE;
      stop
    case ( revise_code )
      if (code_revisions < 2?) then (yes)
        :code_revisions++;
      else (no)
        :Fail — revision cap;
        stop
      endif
    case ( revise_design )
      if (design_revisions < 1?) then (yes)
        :design_revisions++;
        :Re-run **Solution Architect**;
      else (no)
        :Fail — revision cap;
        stop
      endif
    endswitch
  else (no)
    :Treat as revise_code;
  endif
repeat while (continue revising?) is (loop)
@enduml
