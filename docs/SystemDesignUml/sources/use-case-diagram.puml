@startuml UseCaseDiagram
!include _theme.iuml
title **Aegis — Use Case Diagram**\n<size:11><color:#666666>Actor interactions with the system</color></size>

left to right direction

actor "Non-technical\nUser" as User
actor "Anthropic\nClaude API" as LLM <<external>>

rectangle "Aegis Pipeline" {
  usecase "Submit application\ndescription (intake)" as UC1
  usecase "Answer clarification\nquestions" as UC2
  usecase "Observe pipeline\nprogress (SSE)" as UC3
  usecase "Download generated\napp (ZIP)" as UC4
  usecase "Launch generated\napp locally" as UC5
  usecase "Replay past run\nby URL" as UC6
  usecase "Run Requirements\nAnalyst" as A1
  usecase "Run Solution\nArchitect" as A2
  usecase "Run Developer" as A3
  usecase "Run Build Check" as A4
  usecase "Run QA Reviewer" as A5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

UC1 ..> A1 : <<include>>
A1  ..> A2 : <<include>>
A2  ..> A3 : <<include>>
A3  ..> A4 : <<include>>
A4  ..> A5 : <<include>>
A2  ..> UC2 : <<extend>>\nif ambiguous

A1 ..> LLM : «uses»
A2 ..> LLM : «uses»
A3 ..> LLM : «uses»
A5 ..> LLM : «uses»
@enduml
