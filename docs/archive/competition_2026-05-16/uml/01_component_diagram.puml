@startuml AegisComponentDiagram
' Aegis — High-Level Component Diagram (UML 2.5)
' Goal: tek bakışta anlaşılır; sadece 4 ajan + müşteri + LLM + çıktı.

!pragma layout smetana
skinparam backgroundColor #1A1B26
skinparam defaultFontName "Inter, Helvetica, Arial"
skinparam defaultFontColor #E6E9EF
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 12

skinparam component {
  BackgroundColor #2B2F40
  BorderColor #7AA2F7
  BorderThickness 2
  FontColor #E6E9EF
  FontSize 16
  ArrowColor #9ECE6A
  ArrowFontColor #C0CAF5
  ArrowFontSize 14
}
skinparam package {
  BackgroundColor #232634
  BorderColor #BB9AF7
  BorderThickness 2
  FontColor #C0CAF5
  FontStyle bold
  FontSize 18
}
skinparam actor {
  BackgroundColor #2B2F40
  BorderColor #E0AF68
  FontColor #E6E9EF
  FontSize 16
}
skinparam folder {
  BackgroundColor #2B2F40
  BorderColor #73DACA
  FontColor #E6E9EF
  FontSize 16
}
skinparam cloud {
  BackgroundColor #2B2F40
  BorderColor #BB9AF7
  FontColor #E6E9EF
  FontSize 16
}

title <b>Aegis — Component Diagram</b>

actor "Müşteri" as User #E0AF68

package "Aegis  «Sanal Yazılım Şirketi»" as Aegis {
  component "Gereksinim\nAnalisti" as RA
  component "Çözüm\nMimarı" as SA
  component "Geliştirici" as DEV
  component "Kalite\nGüvence" as QA
}

cloud "Claude LLM" as LLM
folder "Çalışan\nWeb Uygulaması" as APP #73DACA

User -down-> Aegis : <b>1.</b> Fikir (doğal dil)
RA -right-> SA
SA -right-> DEV
DEV -right-> QA
Aegis -down-> APP : <b>2.</b> Tam yığın\nNext.js + SQLite

RA ..> LLM
SA ..> LLM
DEV ..> LLM
QA ..> LLM

@enduml
